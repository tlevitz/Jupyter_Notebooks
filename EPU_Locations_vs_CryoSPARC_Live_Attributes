    "# Match CryoSPARC micrographs to EPU micrograph positions\n",
    "\n",
    "def micrograph_match_key(path):\n",
    "    if path is None or pd.isna(path):\n",
    "        return None\n",
    "\n",
    "    name = Path(str(path).strip()).name.casefold()\n",
    "\n",
    "    # Remove recognized file extensions. Repeat to handle names such as\n",
    "    # micrograph.eer.xml.\n",
    "    known_extensions = (\n",
    "        \".xml\",\n",
    "        \".mrc\",\n",
    "        \".mrcs\",\n",
    "        \".tif\",\n",
    "        \".tiff\",\n",
    "        \".eer\",\n",
    "        \".jpg\",\n",
    "        \".jpeg\",\n",
    "        \".png\",\n",
    "    )\n",
    "\n",
    "    extension_removed = True\n",
    "\n",
    "    while extension_removed:\n",
    "        extension_removed = False\n",
    "\n",
    "        for extension in known_extensions:\n",
    "            if name.endswith(extension):\n",
    "                name = name[:-len(extension)]\n",
    "                extension_removed = True\n",
    "                break\n",
    "\n",
    "    # Remove CryoSPARC processing suffixes. Using a loop handles compound\n",
    "    # names such as:\n",
    "    #\n",
    "    #   *_Fractions_0000000001_patch_aligned_doseweighted.mrc\n",
    "    #\n",
    "    previous_name = None\n",
    "\n",
    "    while name != previous_name:\n",
    "        previous_name = name\n",
    "\n",
    "        name = re.sub(\n",
    "            r\"_patch_aligned_doseweighted$\",\n",
    "            \"\",\n",
    "            name,\n",
    "            flags=re.IGNORECASE,\n",
    "        )\n",
    "\n",
    "        name = re.sub(\n",
    "            r\"_patch_aligned$\",\n",
    "            \"\",\n",
    "            name,\n",
    "            flags=re.IGNORECASE,\n",
    "        )\n",
    "\n",
    "        name = re.sub(\n",
    "            r\"_doseweighted$\",\n",
    "            \"\",\n",
    "            name,\n",
    "            flags=re.IGNORECASE,\n",
    "        )\n",
    "\n",
    "        # Handles:\n",
    "        #   *_Fractions\n",
    "        #   *_Fractions_0000000001\n",
    "        #   *_Fractions_123\n",
    "        name = re.sub(\n",
    "            r\"_fractions(?:_\\d+)?$\",\n",
    "            \"\",\n",
    "            name,\n",
    "            flags=re.IGNORECASE,\n",
    "        )\n",
    "\n",
    "    return name.casefold()\n",
    "\n",
    "df_all[\"match_key\"] = df_all[\"path\"].map(\n",
    "    micrograph_match_key\n",
    ")\n",
    "\n",
    "df_positions[\"match_key\"] = (\n",
    "    df_positions[\"fractions_path\"]\n",
    "    .map(micrograph_match_key)\n",
    ")\n",
    "\n",
    "duplicate_position_keys = (\n",
    "    df_positions[\"match_key\"]\n",
    "    .dropna()\n",
    "    .duplicated()\n",
    "    .sum()\n",
    ")\n",
    "\n",
    "if duplicate_position_keys:\n",
    "    print(\n",
    "        f\"Warning: {duplicate_position_keys:,} duplicate \"\n",
    "        \"EPU position keys were found. Keeping the first \"\n",
    "        \"position for each key.\"\n",
    "    )\n",
    "\n",
    "position_table = (\n",
    "    df_positions\n",
    "    .dropna(subset=[\"match_key\"])\n",
    "    .drop_duplicates(\n",
    "        subset=[\"match_key\"],\n",
    "        keep=\"first\",\n",
    "    )\n",
    ")\n",
    "\n",
    "df_merged = df_all.merge(\n",
    "    position_table,\n",
    "    on=\"match_key\",\n",
    "    how=\"left\",\n",
    "    suffixes=(\"_cryosparc\", \"_epu\"),\n",
    ")\n",
    "\n",
    "matched_positions = int(\n",
    "    df_merged[\"x0_centered\"].notna().sum()\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Matched {matched_positions:,} of \"\n",
    "    f\"{len(df_merged):,} CryoSPARC micrographs \"\n",
    "    \"to EPU atlas coordinates\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    df_merged[\n",
    "        [\n",
    "            \"path\",\n",
    "            \"exposure_number\",\n",
    "            PLOT_ATTRIBUTE,\n",
    "            \"grid_square_id\",\n",
    "            \"foilhole_uniq\",\n",
    "            \"x0_centered\",\n",
    "            \"y0_centered_up\",\n",
    "            \"status\",\n",
    "        ]\n",
    "    ].head(20)\n",
    ")"
   ]
