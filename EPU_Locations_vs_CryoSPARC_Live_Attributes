    "    if \"_Fractions_patch_aligned_doseweighted.mrc\" in s:\n",
    "        s = s[: s.find(\"_Fractions_patch_aligned_doseweighted.mrc\")]\n",
    "\n",
    "    # strip one extension\n",
    "    for ext in (\".mrc\", \".tif\", \".tiff\", \".eer\", \".png\", \".jpg\", \".jpeg\"):\n",
    "        if s.lower().endswith(ext):\n",
    "            s = s[: -len(ext)]\n",
