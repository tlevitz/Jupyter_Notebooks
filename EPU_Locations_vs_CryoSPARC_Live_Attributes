    "        \"accepted\": accepted,\n",
    "        \"rejected\": rejected,\n",
    "        \"failed\": failed,\n",
    "        \"status\": exposure_status_label(exposure),\n",
    "        \"status_binary\": status_binary,\n",
    "        \"start_dt\": exposure_start_datetime(exposure),\n",
    "        \"end_dt\": exposure_end_datetime(exposure),\n",
    "    }\n",
    "\n",
    "def assign_exposure_numbers(parsed_exposures):\n",
    "    \"\"\"Assign chronological 1-based exposure numbers.\"\"\"\n",
    "    def sort_key(exposure):\n",
    "        timestamp = (\n",
    "            exposure.get(\"start_dt\")\n",
    "            or exposure.get(\"end_dt\")\n",
    "            or datetime.max.replace(\n",
    "                tzinfo=timezone.utc\n",
    "            )\n",
    "        )\n",
    "\n",
    "        uid = exposure.get(\"uid\")\n",
    "\n",
    "        return (\n",
    "            timestamp,\n",
    "            str(uid) if uid is not None else \"\",\n",
    "        )\n",
    "\n",
    "    result = sorted(\n",
    "        parsed_exposures,\n",
    "        key=sort_key,\n",
    "    )\n",
    "\n",
    "    for number, exposure in enumerate(\n",
    "        result,\n",
    "        start=1,\n",
    "    ):\n",
    "        exposure[\"exposure_number\"] = number\n",
    "\n",
    "    return result\n",
    "\n",
    "def assign_elapsed_minutes(parsed_exposures):\n",
    "    \"\"\"Calculate elapsed minutes relative to the first exposure.\"\"\"\n",
    "    start_times = [\n",
    "        exposure.get(\"start_dt\")\n",
    "        for exposure in parsed_exposures\n",
    "        if exposure.get(\"start_dt\") is not None\n",
    "    ]\n",
    "\n",
    "    if not start_times:\n",
    "        for exposure in parsed_exposures:\n",
    "            exposure[\"elapsed_minutes\"] = None\n",
    "\n",
    "        return parsed_exposures\n",
    "\n",
    "    first_start = min(start_times)\n",
    "\n",
    "    for exposure in parsed_exposures:\n",
    "        start_time = exposure.get(\"start_dt\")\n",
    "\n",
    "        exposure[\"elapsed_minutes\"] = (\n",
    "            None\n",
    "            if start_time is None\n",
    "            else (\n",
    "                start_time - first_start\n",
    "            ).total_seconds() / 60.0\n",
    "        )\n",
    "\n",
    "    return parsed_exposures"
   ]
