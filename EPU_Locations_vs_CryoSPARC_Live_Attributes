    "print(\n",
    "    f\"Read {len(raw_exposure_records):,} raw exposure records \"\n",
    "    f\"from {EXPOSURES_BSON}\"\n",
    ")\n",
    "\n",
    "parsed = [\n",
    "    parse_exposure_light(\n",
    "        CRYOSPARC_PROJECT_DIR,\n",
    "        CRYOSPARC_SESSION_NAME,\n",
    "        exposure,\n",
    "    )\n",
    "    for exposure in raw_exposure_records\n",
