    "# BSON and general-purpose parsing helpers\n",
    "\n",
    "def nested_get(obj, *keys):\n",
    "    \"\"\"Safely retrieve a value from nested dictionaries.\"\"\"\n",
    "    value = obj\n",
    "\n",
    "    for key in keys:\n",
    "        if not isinstance(value, dict):\n",
    "            return None\n",
    "\n",
    "        value = value.get(key)\n",
    "\n",
    "        if value is None:\n",
    "            return None\n",
    "\n",
    "    return value\n",
    "\n",
    "def unwrap_singleton(value):\n",
    "    \"\"\"Unwrap values stored as one-element lists or tuples.\"\"\"\n",
    "    while isinstance(value, (list, tuple)) and len(value) == 1:\n",
    "        value = value[0]\n",
    "\n",
    "    return value\n",
    "\n",
    "def resolve_project_path(project_dir, value):\n",
    "    \"\"\"\n",
    "    Resolve a possibly wrapped CryoSPARC project-relative path.\n",
    "\n",
    "    Unlike the report helper, this retains the resolved path even when\n",
    "    the file is not currently mounted. That allows filename matching\n",
    "    against the EPU session.\n",
    "    \"\"\"\n",
    "    value = unwrap_singleton(value)\n",
    "\n",
    "    if not isinstance(value, str) or value in (\"\", \".\"):\n",
    "        return None\n",
    "\n",
    "    value = os.path.expanduser(value)\n",
    "\n",
    "    if os.path.isabs(value):\n",
    "        return os.path.normpath(value)\n",
    "\n",
    "    return os.path.normpath(\n",
    "        os.path.join(project_dir, value)\n",
    "    )\n",
    "\n",
    "def path_from_nested(project_dir, obj, *keys):\n",
    "    return resolve_project_path(\n",
    "        project_dir,\n",
    "        nested_get(obj, *keys),\n",
    "    )\n",
    "\n",
    "def safe_float(value):\n",
    "    \"\"\"Return a finite float or None.\"\"\"\n",
    "    value = unwrap_singleton(value)\n",
    "\n",
    "    try:\n",
    "        value = float(value)\n",
    "    except (TypeError, ValueError):\n",
    "        return None\n",
    "\n",
    "    return value if np.isfinite(value) else None\n",
    "\n",
    "def safe_int(value):\n",
    "    \"\"\"Return an integer or None.\"\"\"\n",
    "    value = unwrap_singleton(value)\n",
    "\n",
    "    try:\n",
    "        return int(value)\n",
    "    except (TypeError, ValueError):\n",
    "        return None\n",
    "\n",
    "def prefer_positive(primary, fallback):\n",
    "    \"\"\"\n",
    "    Use primary when it is finite and positive; otherwise use fallback.\n",
    "    \"\"\"\n",
    "    primary = safe_float(primary)\n",
    "\n",
    "    if primary is not None and primary > 0:\n",
    "        return primary\n",
    "\n",
    "    fallback = safe_float(fallback)\n",
    "\n",
    "    if fallback is not None:\n",
    "        return fallback\n",
    "\n",
    "    return primary\n",
    "\n",
    "def prefer_positive_int(primary, fallback):\n",
    "    \"\"\"\n",
    "    Integer version of prefer_positive().\n",
    "    \"\"\"\n",
    "    primary = safe_int(primary)\n",
    "\n",
    "    if primary is not None and primary > 0:\n",
    "        return primary\n",
    "\n",
    "    fallback = safe_int(fallback)\n",
    "\n",
    "    if fallback is not None:\n",
    "        return fallback\n",
    "\n",
    "    return primary\n",
    "\n",
    "def to_datetime(value):\n",
    "    \"\"\"\n",
    "    Convert Python datetimes, Unix epochs, ISO strings, and Mongo-style\n",
    "    JSON dates to timezone-aware datetime objects.\n",
    "    \"\"\"\n",
    "    value = unwrap_singleton(value)\n",
    "\n",
    "    if value is None:\n",
    "        return None\n",
    "\n",
    "    if isinstance(value, dict) and \"$date\" in value:\n",
    "        return to_datetime(value[\"$date\"])\n",
    "\n",
    "    if isinstance(value, datetime):\n",
    "        if value.tzinfo is None:\n",
    "            return value.replace(tzinfo=timezone.utc)\n",
    "\n",
    "        return value\n",
    "\n",
    "    if isinstance(value, (int, float, np.integer, np.floating)):\n",
    "        if not np.isfinite(value):\n",
    "            return None\n",
    "\n",
    "        unit = \"ms\" if abs(float(value)) > 1e11 else \"s\"\n",
    "\n",
    "        result = pd.to_datetime(\n",
    "            value,\n",
    "            unit=unit,\n",
    "            utc=True,\n",
    "            errors=\"coerce\",\n",
    "        )\n",
    "\n",
    "    else:\n",
    "        result = pd.to_datetime(\n",
    "            value,\n",
    "            utc=True,\n",
    "            errors=\"coerce\",\n",
    "        )\n",
    "\n",
    "    if pd.isna(result):\n",
    "        return None\n",
    "\n",
    "    return result.to_pydatetime()\n",
