    "# Basic plotting function, shouldn't have to change\n",
    "\n",
    "def plot_micrograph_locations(\n",
    "    data,\n",
    "    attribute,\n",
    "    label,\n",
    "    xlim,\n",
    "    ylim,\n",
    "    marker_size=3,\n",
    "    title=None,\n",
    "    vmin=None,\n",
    "    vmax=None,\n",
    "    cmap=\"Blues_r\",\n",
    "    save_path=None,\n",
    "\n",
    "    # Optional cluster-center overlay\n",
    "    cluster_center_data=None,\n",
    "    show_cluster_centers=False,\n",
    "    cluster_center_color=\"#786f80\",\n",
    "    cluster_center_marker=\"o\",\n",
    "    cluster_center_marker_size=35,\n",
    "    cluster_center_linewidth=1.5,\n",
    "    cluster_center_label=(\n",
    "        \"Cluster-center foil hole\"\n",
    "    ),\n",
    "):\n",
    "    \"\"\"\n",
    "    Plot one CryoSPARC attribute at each EPU atlas location.\n",
    "\n",
    "    Optionally overlay the positions of foil holes identified as\n",
    "    cluster centers by corresponding FoilHoles/FoilHole_*.jpg files.\n",
    "    \"\"\"\n",
    "    x_axis = \"x0_centered\"\n",
    "    y_axis = \"y0_centered_up\"\n",
    "\n",
    "    required_columns = [\n",
    "        x_axis,\n",
    "        y_axis,\n",
    "        attribute,\n",
    "    ]\n",
    "\n",
    "    missing_columns = [\n",
    "        column\n",
    "        for column in required_columns\n",
    "        if column not in data.columns\n",
    "    ]\n",
    "\n",
    "    if missing_columns:\n",
    "        raise KeyError(\n",
    "            \"Missing plotting columns: \"\n",
    "            + \", \".join(missing_columns)\n",
    "        )\n",
    "\n",
    "    plot_data = data[\n",
    "        required_columns\n",
    "    ].copy()\n",
    "\n",
    "    for column in required_columns:\n",
    "        plot_data[column] = pd.to_numeric(\n",
    "            plot_data[column],\n",
    "            errors=\"coerce\",\n",
    "        )\n",
    "\n",
    "    plot_data = plot_data.dropna(\n",
    "        subset=required_columns\n",
    "    )\n",
    "\n",
    "    if plot_data.empty:\n",
    "        raise ValueError(\n",
    "            f\"No EPU-matched micrographs have numeric \"\n",
    "            f\"values for {attribute!r}.\"\n",
    "        )\n",
    "\n",
    "    values = plot_data[attribute]\n",
    "\n",
    "    if vmin is None:\n",
    "        vmin = float(\n",
    "            values.quantile(0.02)\n",
    "        )\n",
    "\n",
    "    if vmax is None:\n",
    "        vmax = float(\n",
    "            values.quantile(0.98)\n",
    "        )\n",
    "\n",
    "    if vmin == vmax:\n",
    "        padding = (\n",
    "            abs(vmin) * 0.01\n",
    "            if vmin != 0\n",
    "            else 1.0\n",
    "        )\n",
    "\n",
    "        vmin -= padding\n",
    "        vmax += padding\n",
    "\n",
    "    fig, ax = plt.subplots(\n",
    "        figsize=(8, 7)\n",
    "    )\n",
    "\n",
    "    points = ax.scatter(\n",
    "        plot_data[x_axis],\n",
    "        plot_data[y_axis],\n",
    "        c=plot_data[attribute],\n",
    "        cmap=cmap,\n",
    "        vmin=vmin,\n",
    "        vmax=vmax,\n",
    "        s=marker_size,\n",
    "        alpha=1,\n",
    "        zorder=1,\n",
    "    )\n",
    "\n",
    "    colorbar = fig.colorbar(\n",
    "        points,\n",
    "        ax=ax,\n",
    "    )\n",
    "\n",
    "    colorbar.set_label(label)\n",
    "\n",
    "    # --------------------------------------------------------------\n",
    "    # Optional cluster-center overlay\n",
    "    # --------------------------------------------------------------\n",
    "\n",
    "    if (\n",
    "        show_cluster_centers\n",
    "        and cluster_center_data is not None\n",
    "        and not cluster_center_data.empty\n",
    "    ):\n",
    "        center_data = cluster_center_data[\n",
    "            [\n",
    "                x_axis,\n",
    "                y_axis,\n",
    "            ]\n",
    "        ].copy()\n",
    "\n",
    "        center_data[x_axis] = pd.to_numeric(\n",
    "            center_data[x_axis],\n",
    "            errors=\"coerce\",\n",
    "        )\n",
    "\n",
    "        center_data[y_axis] = pd.to_numeric(\n",
    "            center_data[y_axis],\n",
    "            errors=\"coerce\",\n",
    "        )\n",
    "\n",
    "        center_data = center_data.dropna(\n",
    "            subset=[\n",
    "                x_axis,\n",
    "                y_axis,\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        if not center_data.empty:\n",
    "            # An unfilled ring keeps the underlying attribute color\n",
    "            # visible while clearly marking the cluster center.\n",
    "            ax.scatter(\n",
    "                center_data[x_axis],\n",
    "                center_data[y_axis],\n",
    "                s=cluster_center_marker_size,\n",
    "                marker=cluster_center_marker,\n",
    "                facecolors=\"none\",\n",
    "                edgecolors=cluster_center_color,\n",
    "                linewidths=cluster_center_linewidth,\n",
    "                label=cluster_center_label,\n",
    "                zorder=3,\n",
    "            )\n",
    "\n",
    "            ax.legend(\n",
    "                loc=\"best\",\n",
    "                frameon=True,\n",
    "            )\n",
    "\n",
    "    ax.set_title(\n",
    "        title\n",
    "        or f\"Micrograph Locations Colored by {label}\"\n",
    "    )\n",
    "\n",
    "    ax.set_xlabel(\"Relative Position X\")\n",
    "    ax.set_ylabel(\"Relative Position Y\")\n",
    "\n",
    "    ax.set_xlim(*xlim)\n",
    "    ax.set_ylim(*ylim)\n",
    "\n",
    "    ax.set_aspect(\n",
    "        \"equal\",\n",
    "        adjustable=\"box\",\n",
    "    )\n",
    "\n",
    "    ax.grid(False)\n",
    "\n",
    "    fig.tight_layout()\n",
    "\n",
    "    if save_path is not None:\n",
    "        save_path = Path(save_path)\n",
    "\n",
    "        save_path.parent.mkdir(\n",
    "            parents=True,\n",
    "            exist_ok=True,\n",
    "        )\n",
    "\n",
    "        fig.savefig(\n",
    "            save_path,\n",
    "            dpi=300,\n",
    "            bbox_inches=\"tight\",\n",
    "        )\n",
    "\n",
    "        print(f\"Saved: {save_path}\")\n",
    "\n",
    "    plt.show()\n",
    "\n",
    "    return fig, ax"
   ]
