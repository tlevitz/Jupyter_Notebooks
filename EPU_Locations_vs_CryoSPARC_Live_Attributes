    "    \"total_extracted_particles_template\": (\n",
    "        \"Template Picker Particles Extracted\"\n",
    "    ),\n",
    "}\n",
    "\n",
    "def parsed_exposures_to_dataframe(\n",
    "    parsed_exposures,\n",
    "):\n",
    "    \"\"\"\n",
    "    Create one DataFrame row per CryoSPARC exposure.\n",
    "\n",
    "    Every top-level parsed field and every extra field under\n",
    "    raw[\"attributes\"] is retained.\n",
    "    \"\"\"\n",
    "    rows = []\n",
    "\n",
    "    for exposure in parsed_exposures:\n",
    "        raw = exposure.get(\"raw\") or {}\n",
    "        raw_attributes = raw.get(\"attributes\") or {}\n",
    "\n",
    "        # Retain every raw attribute.\n",
    "        row = dict(raw_attributes)\n",
    "\n",
    "        # Parsed values take precedence.\n",
    "        row.update(\n",
    "            {\n",
    "                key: value\n",
    "                for key, value in exposure.items()\n",
    "                if key != \"raw\"\n",
    "            }\n",
    "        )\n",
    "\n",
    "        # Generic path used for EPU matching.\n",
    "        row[\"path\"] = (\n",
    "            exposure.get(\"micrograph_path\")\n",
    "            or exposure.get(\n",
    "                \"micrograph_non_dw_path\"\n",
    "            )\n",
    "            or exposure.get(\"movie_path\")\n",
    "            or exposure.get(\"abs_file_path\")\n",
    "        )\n",
    "\n",
    "        rows.append(row)\n",
    "\n",
    "    result = pd.DataFrame(rows)\n",
    "\n",
    "    expected_columns = [\n",
    "        \"path\",\n",
    "        \"exposure_number\",\n",
    "        *LOCATION_PLOT_ATTRIBUTES,\n",
    "        \"accepted\",\n",
    "        \"rejected\",\n",
    "        \"failed\",\n",
    "        \"status\",\n",
    "        \"status_binary\",\n",
    "        \"uid\",\n",
    "        \"picker_type\",\n",
    "        \"start_dt\",\n",
    "        \"end_dt\",\n",
    "        \"micrograph_path\",\n",
    "        \"micrograph_non_dw_path\",\n",
    "        \"movie_path\",\n",
    "        \"abs_file_path\",\n",
    "    ]\n",
    "\n",
    "    for column in expected_columns:\n",
    "        if column not in result.columns:\n",
    "            result[column] = pd.NA\n",
    "\n",
    "    for column in LOCATION_PLOT_ATTRIBUTES:\n",
    "        result[column] = pd.to_numeric(\n",
    "            result[column],\n",
    "            errors=\"coerce\",\n",
    "        )\n",
    "\n",
    "    result[\"start_dt\"] = pd.to_datetime(\n",
    "        result[\"start_dt\"],\n",
    "        errors=\"coerce\",\n",
    "        utc=True,\n",
    "    )\n",
    "\n",
    "    result[\"end_dt\"] = pd.to_datetime(\n",
    "        result[\"end_dt\"],\n",
    "        errors=\"coerce\",\n",
    "        utc=True,\n",
    "    )\n",
    "\n",
    "    preferred_columns = []\n",
    "\n",
    "    for column in expected_columns:\n",
    "        if column not in preferred_columns:\n",
    "            preferred_columns.append(column)\n",
    "\n",
    "    extra_columns = [\n",
    "        column\n",
    "        for column in result.columns\n",
    "        if column not in preferred_columns\n",
    "    ]\n",
    "\n",
    "    return result[\n",
    "        preferred_columns + extra_columns\n",
    "    ].reset_index(drop=True)\n",
    "\n",
    "df_all = parsed_exposures_to_dataframe(\n",
    "    parsed\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Created df_all with \"\n",
    "    f\"{len(df_all):,} micrographs and \"\n",
    "    f\"{len(df_all.columns):,} columns\"\n",
    ")\n",
    "\n",
    "display(df_all.head())"
