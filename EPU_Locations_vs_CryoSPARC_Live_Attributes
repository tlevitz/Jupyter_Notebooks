    "        \"Relative Ice Thickness\"\n",
    "    ),\n",
    "    \"total_extracted_particles\": (\n",
    "        \"Total Extracted Particles\"\n",
    "    ),\n",
    "    \"defocus_range\": \"Defocus Range (Å)\",\n",
    "    \"astigmatism_angle\": (\n",
    "        \"Astigmatism Angle (deg)\"\n",
    "    ),\n",
    "    \"astigmatism\": \"Astigmatism\",\n",
    "    \"phase_shift\": \"Phase Shift (deg)\",\n",
