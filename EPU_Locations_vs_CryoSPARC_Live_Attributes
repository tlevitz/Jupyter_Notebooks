    "# CryoSPARC exposure status, time, and attribute helpers\n",
    "\n",
    "def is_rejected_exposure(exposure):\n",
    "    return (\n",
    "        bool(exposure.get(\"manual_reject\"))\n",
    "        or bool(exposure.get(\"threshold_reject\"))\n",
    "    )\n",
    "\n",
    "\n",
    "def is_failed_exposure(exposure):\n",
    "    return bool(exposure.get(\"failed\"))\n",
    "\n",
    "\n",
    "def is_accepted_exposure(exposure):\n",
    "    return (\n",
    "        not bool(exposure.get(\"deleted\"))\n",
    "        and not bool(exposure.get(\"test\"))\n",
    "        and not is_failed_exposure(exposure)\n",
    "        and not is_rejected_exposure(exposure)\n",
    "        and exposure.get(\"stage\") == \"ready\"\n",
    "    )\n",
    "\n",
    "\n",
    "def exposure_status_label(exposure):\n",
    "    if is_failed_exposure(exposure):\n",
    "        return \"Failed\"\n",
    "\n",
    "    if is_rejected_exposure(exposure):\n",
    "        return \"Rejected\"\n",
    "\n",
    "    if is_accepted_exposure(exposure):\n",
    "        return \"Accepted\"\n",
    "\n",
    "    return str(exposure.get(\"stage\") or \"Unknown\")\n",
    "\n",
    "\n",
    "def exposure_start_datetime(exposure):\n",
    "    attributes = exposure.get(\"attributes\") or {}\n",
    "\n",
    "    timestamp = to_datetime(\n",
    "        attributes.get(\"found_at\")\n",
    "    )\n",
    "\n",
    "    if timestamp is not None:\n",
    "        return timestamp\n",
    "\n",
    "    for key in (\"discovered_at\", \"created_at\"):\n",
    "        timestamp = to_datetime(exposure.get(key))\n",
    "\n",
    "        if timestamp is not None:\n",
    "            return timestamp\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "def exposure_end_datetime(exposure):\n",
    "    attributes = exposure.get(\"attributes\") or {}\n",
    "\n",
    "    for key in (\n",
    "        \"ready_at\",\n",
    "        \"extract_at\",\n",
    "        \"pick_at\",\n",
    "        \"ctf_at\",\n",
    "        \"motion_at\",\n",
    "    ):\n",
    "        timestamp = to_datetime(\n",
    "            attributes.get(key)\n",
    "        )\n",
    "\n",
    "        if timestamp is not None:\n",
    "            return timestamp\n",
    "\n",
    "    return to_datetime(\n",
    "        exposure.get(\"updated_at\")\n",
    "    )\n",
    "\n",
    "def extracted_particle_count(exposure):\n",
    "    attributes = exposure.get(\"attributes\") or {}\n",
    "\n",
    "    picker_type = str(\n",
