    ")\n",
    "\n",
    "# ------------------------------------------------------------------\n",
    "# Attributes supported by the CryoSPARC report plots\n",
    "# ------------------------------------------------------------------\n",
    "\n",
    "LOCATION_PLOT_ATTRIBUTES = {\n",
    "    \"elapsed_minutes\": \"Time Since Start (min)\",\n",
    "    \"ctf_fit_to_A\": \"CTF Fit (Å)\",\n",
    "    \"average_defocus\": \"Average Defocus (Å)\",\n",
