    "    # if df_all sometimes stores _Fractions.xml, map it to the base xml\n",
    "    p = re.sub(r\"_Fractions\\.xml$\", \".xml\", p, flags=re.IGNORECASE)\n",
    "    return p\n",
    "\n",
    "def file_to_xml_candidates(file_value: str) -> list[str]:\n",
