    "\n",
    "    return [\n",
    "        f\"{s}.xml\",\n",
    "        f\"{s}_Fractions.xml\",  # sometimes you might have only this\n",
    "        f\"{s}.eer.xml\",\n",
    "    ]\n",
    "\n",
